# Backend environment configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YegnaConnect DB
DB_USER=postgres
DB_PASSWORD=your-db-password

# Auth
JWT_SECRET=replace-with-a-long-random-string

# SMSEthiopia (https://smsethiopia.com) - Console > API Keys
SMS_API_KEY=your-smsethiopia-api-key
# Optional override; defaults to https://smsethiopia.com/api/sms/send
SMS_API_URL=